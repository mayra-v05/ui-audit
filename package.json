{
  "name": "ui-audit",
  "displayName": "UI Audit — design & bug checker",
  "description": "Scans your site or local dev server for UI bugs (alignment, spacing, padding, responsive), dead buttons/links and backend errors. Dashboard per project, device preview and export to Claude, Claude Code or mail.",
  "version": "0.2.0",
  "publisher": "mayavx",
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ui",
    "design",
    "qa",
    "responsive",
    "spacing",
    "accessibility",
    "audit",
    "claude"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "uiAudit",
          "title": "UI Audit",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "uiAudit": [
        {
          "id": "uiAudit.projects",
          "name": "Projecten",
          "icon": "media/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "uiAudit.projects",
        "contents": "Check a live website or your local dev server for UI bugs, dead buttons and backend errors.\n[$(link) Check a URL](command:uiAudit.quickCheck)\n[$(add) Project with dev server](command:uiAudit.newProject)\n[$(dashboard) Open dashboard](command:uiAudit.openDashboard)"
      }
    ],
    "commands": [
      {
        "command": "uiAudit.quickCheck",
        "title": "Check a URL (paste link)",
        "category": "UI Audit",
        "icon": "$(link)"
      },
      {
        "command": "uiAudit.openDashboard",
        "title": "Open dashboard",
        "category": "UI Audit",
        "icon": "$(dashboard)"
      },
      {
        "command": "uiAudit.newProject",
        "title": "New project",
        "category": "UI Audit",
        "icon": "$(add)"
      },
      {
        "command": "uiAudit.scan",
        "title": "Scan project",
        "category": "UI Audit",
        "icon": "$(play)"
      },
      {
        "command": "uiAudit.scanAll",
        "title": "Scan all projects",
        "category": "UI Audit",
        "icon": "$(run-all)"
      },
      {
        "command": "uiAudit.preview",
        "title": "Device preview (phone / tablet / desktop)",
        "category": "UI Audit",
        "icon": "$(device-mobile)"
      },
      {
        "command": "uiAudit.toggleLive",
        "title": "Toggle Live mode (scan on save)",
        "category": "UI Audit",
        "icon": "$(eye)"
      },
      {
        "command": "uiAudit.editProject",
        "title": "Edit project",
        "category": "UI Audit",
        "icon": "$(gear)"
      },
      {
        "command": "uiAudit.deleteProject",
        "title": "Delete project",
        "category": "UI Audit",
        "icon": "$(trash)"
      },
      {
        "command": "uiAudit.copyForClaude",
        "title": "Copy issues as Claude prompt",
        "category": "UI Audit",
        "icon": "$(sparkle)"
      },
      {
        "command": "uiAudit.fixWithClaudeCode",
        "title": "Fix issues with Claude Code",
        "category": "UI Audit",
        "icon": "$(terminal)"
      },
      {
        "command": "uiAudit.mailDeveloper",
        "title": "Mail issues to developer",
        "category": "UI Audit",
        "icon": "$(mail)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "uiAudit.quickCheck",
          "when": "view == uiAudit.projects",
          "group": "navigation@0"
        },
        {
          "command": "uiAudit.newProject",
          "when": "view == uiAudit.projects",
          "group": "navigation@1"
        },
        {
          "command": "uiAudit.scanAll",
          "when": "view == uiAudit.projects",
          "group": "navigation@2"
        },
        {
          "command": "uiAudit.openDashboard",
          "when": "view == uiAudit.projects",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "uiAudit.scan",
          "when": "viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "uiAudit.preview",
          "when": "viewItem == project",
          "group": "inline@2"
        },
        {
          "command": "uiAudit.scan",
          "when": "viewItem == project",
          "group": "1_main@1"
        },
        {
          "command": "uiAudit.preview",
          "when": "viewItem == project",
          "group": "1_main@2"
        },
        {
          "command": "uiAudit.toggleLive",
          "when": "viewItem == project",
          "group": "1_main@3"
        },
        {
          "command": "uiAudit.copyForClaude",
          "when": "viewItem == project",
          "group": "2_export@1"
        },
        {
          "command": "uiAudit.fixWithClaudeCode",
          "when": "viewItem == project",
          "group": "2_export@2"
        },
        {
          "command": "uiAudit.mailDeveloper",
          "when": "viewItem == project",
          "group": "2_export@3"
        },
        {
          "command": "uiAudit.editProject",
          "when": "viewItem == project",
          "group": "3_edit@1"
        },
        {
          "command": "uiAudit.deleteProject",
          "when": "viewItem == project",
          "group": "3_edit@2"
        }
      ]
    },
    "configuration": {
      "title": "UI Audit",
      "properties": {
        "uiAudit.viewports": {
          "type": "array",
          "default": [],
          "markdownDescription": "Custom viewports to scan. Empty = Desktop 1440, Tablet 768, Mobile 390. Example: `[{\"id\":\"mobile\",\"label\":\"Mobile\",\"width\":375,\"height\":667,\"mobile\":true}]`",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "mobile": {
                "type": "boolean"
              }
            }
          }
        },
        "uiAudit.spacingBase": {
          "type": "number",
          "default": 4,
          "description": "Base of your spacing grid in px. Values that are not a multiple of this are reported as 'off-grid'."
        },
        "uiAudit.clickTest": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "During the scan, actually click buttons that may not do anything, and check whether something happens. **Only use on test/dev environments** (buttons like 'delete', 'pay', 'send' are skipped)."
        },
        "uiAudit.checkLinks": {
          "type": "boolean",
          "default": true,
          "description": "Check that internal links lead to a valid page (no 404/500)."
        },
        "uiAudit.checkExternalLinks": {
          "type": "boolean",
          "default": false,
          "description": "Also check links to other domains."
        },
        "uiAudit.developerEmail": {
          "type": "string",
          "default": "",
          "description": "Default developer email address for 'Mail developer'."
        },
        "uiAudit.chromePath": {
          "type": "string",
          "default": "",
          "description": "Path to Chrome/Edge/Chromium. Empty = detect automatically."
        },
        "uiAudit.timeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Maximum load time per page (ms)."
        },
        "uiAudit.liveDelayMs": {
          "type": "number",
          "default": 1500,
          "description": "Delay after saving before Live mode rescans (ms)."
        },
        "uiAudit.reloadPreviewOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Reload the device preview when you save a file."
        },
        "uiAudit.showInProblems": {
          "type": "boolean",
          "default": true,
          "description": "Also show found issues in the Problems panel, on the line in your source code."
        }
      }
    },
    "keybindings": [
      {
        "command": "uiAudit.quickCheck",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u"
      }
    ]
  },
  "scripts": {
    "test": "node test/run.js",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "build": "esbuild extension.js --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js --log-level=warning",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "puppeteer-core": "^24.43.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.12"
  }
}